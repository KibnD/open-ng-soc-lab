# Copy only into a private local environment and replace placeholders there.
# Never commit the resulting .env file.

WAZUH_MANAGER_URL=https://wazuh-manager.example
MISP_URL=https://misp.example
MISP_API_KEY=replace-in-private-environment
MISP_CA_BUNDLE=/path/to/private-ca.pem
MISP_CONNECT_TIMEOUT=3
MISP_READ_TIMEOUT=7
MISP_MAX_RETRIES=2
SHUFFLE_WEBHOOK_URL=https://shuffle.example/replace-in-private-environment
SLACK_CHANNEL_ID=replace-in-private-environment
