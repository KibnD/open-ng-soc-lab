{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/open-ng-soc-lab/manifest.schema.json",
  "type": "object",
  "required": ["schema_version","project_version","tested_wazuh_versions","release_status","detections"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type":"string"},
    "schema_version": {"const":"1.0.0"},
    "project_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "tested_wazuh_versions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
    "release_status": {"enum":["pre-release-blocked","release-candidate","released"]},
    "detections": {"type":"array","minItems":10,"items":{"$ref":"#/$defs/detection"}}
  },
  "$defs": {
    "nullablePath": {"type":["string","null"],"pattern":"^[A-Za-z0-9_./-]+$"},
    "detection": {
      "type":"object","additionalProperties":false,
      "required":["rule_id","title","data_source","prerequisites","expected_decoder","expected_level","mitre","mitre_justification","evidence_status","positive_fixture","negative_fixture","expected_result","release_target","cleanup","limitations"],
      "properties": {
        "rule_id":{"type":"integer","minimum":100000,"maximum":120000},
        "title":{"type":"string","minLength":5},
        "data_source":{"type":"string","minLength":3},
        "prerequisites":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},
        "expected_decoder":{"type":"string","minLength":1},
        "expected_level":{"type":"integer","minimum":0,"maximum":16},
        "mitre":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^T[0-9]{4}(?:\\.[0-9]{3})?$"}},
        "mitre_justification":{"type":"string","minLength":10},
        "evidence_status":{"enum":["implemented-private","tested-private","reproduced-public","documented-only","simulated","target"]},
        "positive_fixture":{"$ref":"#/$defs/nullablePath"},
        "negative_fixture":{"$ref":"#/$defs/nullablePath"},
        "expected_result":{"$ref":"#/$defs/nullablePath"},
        "release_target":{"type":"string","pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "cleanup":{"type":"string","minLength":5},
        "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}}
      }
    }
  }
}
